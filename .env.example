# ══════════════════════════════════════════
#  Autogarage WhatsApp Chatbot — .env
#  Kopieer dit bestand naar ".env" en vul in
# ══════════════════════════════════════════

# ── Garage informatie ──────────────────────
GARAGE_NAME=Garage De Vries
GARAGE_EMAIL=info@garagedevries.nl
GARAGE_PHONE=020-1234567
GARAGE_ADDRESS=Hoofdstraat 12, 1234 AB Amsterdam

# ── Server ─────────────────────────────────
PORT=3000

# ── Twilio (WhatsApp) ──────────────────────
# Vind deze op: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio sandbox: whatsapp:+14155238886
# Productie: whatsapp:+31XXXXXXXXX (je eigen nummer)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Anthropic (Claude AI) ──────────────────
# Vind deze op: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Calendar ────────────────────────
# Stap 1: Maak OAuth2 credentials aan in Google Cloud Console
#   → https://console.cloud.google.com → APIs & Services → Credentials
#   → Create Credentials → OAuth client ID → Desktop app
# Stap 2: Activeer Google Calendar API
#   → APIs & Services → Library → zoek "Google Calendar API" → Enable
# Stap 3: Haal refresh token op: node scripts/google-auth.js
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Gebruik "primary" voor de hoofdagenda van het account
GOOGLE_CALENDAR_ID=primary

# ── E-mail (Gmail aanbevolen) ──────────────
# Gebruik een Gmail App Password (NIET je gewone wachtwoord):
#   → Google-account → Beveiliging → 2-stapsverificatie → App-wachtwoorden
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=garage@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
# Afzendernaam in de e-mail (kan zelfde zijn als EMAIL_USER)
EMAIL_FROM=garage@gmail.com
