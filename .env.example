# ===== Kopieer dit bestand naar .env en vul in =====
# cp .env.example .env

# --- Claude (verplicht: het "brein" van de bot) ---
# Haal een sleutel bij https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Kanaal: 'simulator' (lokaal testen), 'twilio' of 'whatsapp' (Meta Cloud API) ---
CHANNEL=simulator

# --- Twilio (alleen nodig als CHANNEL=twilio) ---
# https://console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Het WhatsApp-afzendernummer van Twilio, bv. 'whatsapp:+14155238886' (sandbox)
TWILIO_WHATSAPP_FROM=

# --- WhatsApp Cloud API van Meta (alleen nodig als CHANNEL=whatsapp) ---
# Zelfgekozen token voor de webhook-verificatie (verzin een willekeurige string).
WHATSAPP_VERIFY_TOKEN=
# Onderstaande twee zijn pas nodig om berichten te versturen (antwoorden/herinneringen),
# te vinden onder WhatsApp > API Setup in je Meta-app:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Poort waarop de webhook-server luistert (Twilio én WhatsApp Cloud API)
PORT=3000

# --- E-mail voor bevestigingen. Leeg laten = simulatiemodus (alleen console). ---
# Werkt met elke SMTP-provider. Voorbeelden:
#   Gmail:    HOST=smtp.gmail.com  PORT=465  USER=<je Gmail>  PASS=<APP-WACHTWOORD>
#             (2-stapsverificatie aan + maken via https://myaccount.google.com/apppasswords)
#   Resend:   HOST=smtp.resend.com  PORT=465  USER=resend  PASS=<je Resend API-key>
#   Postmark: HOST=smtp.postmarkapp.com  PORT=587  USER=<server-token>  PASS=<server-token>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Afzender (optioneel), bv. 'Garage De Vrij <naam@gmail.com>'. Standaard = SMTP_USER.
SMTP_FROM=

# --- Google Calendar (optioneel: afspraken in jullie Google-agenda spiegelen) ---
# Maak een service-account in Google Cloud, deel je agenda ermee ("wijzigen"),
# en vul hieronder in. Stappen: zie GOOGLE_CALENDAR.md.
# Leeg laten = de bot gebruikt gewoon zijn interne agenda.
GOOGLE_CLIENT_EMAIL=
# Let op: plak de hele private key tussen aanhalingstekens; \n mag als letterlijke tekst.
GOOGLE_PRIVATE_KEY=
# Het id van de agenda (vaak je e-mailadres, of het "Agenda-id" uit de agenda-instellingen).
GOOGLE_CALENDAR_ID=

# --- Tijdzone van de garage (voor openingstijden & afspraken) ---
TZ=Europe/Amsterdam
